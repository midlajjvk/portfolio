<% const extraCss = '<link rel="stylesheet" href="/static/css/project-detail-influencehub.css">' %>
<%- include('../partials/header') %>

<section class="project-detail">

    <div class="project-hero">
        <img src="/static/images/influencehub.png" alt="InfluenceHub Web App">
    </div>

    <h2 class="project-title">InfluenceHub – Influencer Marketing Application</h2>

    <p class="project-description">
        InfluenceHub is an influencer marketing application that connects brands and influencers on a single platform.
        Users can sign up either as a brand or an influencer, enabling seamless collaboration for marketing campaigns.
        The application is built using Flutter and Dart, focusing on smooth user experience, real-time communication,
        and scalable architecture.
    </p>

    <div class="project-info-grid">
        <div class="project-info-block">
            <h3 class="section-heading">Key Features</h3>
            <ul class="feature-list">
                <li>
                    <strong>User roles: Influencer & Brand</strong>
                    <span>Allows users to register and operate based on their role.</span>
                </li>
                <li>
                    <strong>Real-time chat system</strong>
                    <span>Enables instant communication between brands and influencers.</span>
                </li>
                <li>
                    <strong>Campaign collaboration workflow</strong>
                    <span>Simplifies campaign discussions and partnership coordination.</span>
                </li>
                <li>
                    <strong>Modern and intuitive UI</strong>
                    <span>Designed for smooth navigation and user-friendly experience.</span>
                </li>
                <li>
                    <strong>Cross-platform mobile support</strong>
                    <span>Runs seamlessly on both Android and iOS using Flutter.</span>
                </li>
            </ul>
        </div>
        <div class="project-info-block">
            <h3 class="section-heading">Used Technologies</h3>
            <ul class="tech-list">
                <li>Flutter</li>
                <li>Dart</li>
                <li>Firebase</li>
            </ul>
        </div>
    </div>

    <h3 class="section-heading">Screenshots</h3>
    <div class="project-gallery">
        <img src="/static/images/projects/influencehub/pic1.png" alt="InfluenceHub Screenshot 1">
        <img src="/static/images/projects/influencehub/pic2.png" alt="InfluenceHub Screenshot 2">
        <img src="/static/images/projects/influencehub/pic3.png" alt="InfluenceHub Screenshot 3">
        <img src="/static/images/projects/influencehub/pic4.png" alt="InfluenceHub Screenshot 4">
        <img src="/static/images/projects/influencehub/pic5.png" alt="InfluenceHub Screenshot 5">
    </div>

    <div class="project-links">
        <a href="https://github.com/midlajjvk/InfluenceHub" target="_blank" class="btn">GitHub Repository</a>
    </div>

    <div class="challenges-section">
        <h3 class="section-heading">Challenges & Learnings</h3>
        <p class="project-description">
            This project helped me gain hands-on experience in building role-based applications,
            designing scalable UI components, and implementing real-time communication using Flutter.
        </p>
    </div>

    <div class="back-to-projects">
        <a href="/#project" class="back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Projects
        </a>
    </div>

</section>

<%- include('../partials/footer') %>
